build tests/test_full_runtime_stack: CXX_EXECUTABLE_LINKER__test_full_runtime_stack_Release tests/CMakeFiles/test_full_runtime_stack.dir/test_full_runtime_stack.cpp.o | src/common/libpapaya-common.a src/frontend/libpapaya-frontend.a src/steam/libpapaya-steam.a src/cpu/libpapaya-cpu.a src/profile/libpapaya-profile.a src/gpu/libpapaya-gpu.a src/kernel/libpapaya-kernel.a src/audio/libpapaya-audio.a src/input/libpapaya-input.a src/common/libpapaya-common.a || src/audio/libpapaya-audio.a src/common/libpapaya-common.a src/cpu/libpapaya-cpu.a src/frontend/libpapaya-frontend.a src/gpu/libpapaya-gpu.a src/input/libpapaya-input.a src/kernel/libpapaya-kernel.a src/profile/libpapaya-profile.a src/steam/libpapaya-steam.a
  FLAGS = -O3 -DNDEBUG
  LINK_LIBRARIES = src/common/libpapaya-common.a  src/frontend/libpapaya-frontend.a  src/steam/libpapaya-steam.a  src/cpu/libpapaya-cpu.a  src/profile/libpapaya-profile.a  src/gpu/libpapaya-gpu.a  src/kernel/libpapaya-kernel.a  src/audio/libpapaya-audio.a  src/input/libpapaya-input.a  src/common/libpapaya-common.a
  OBJECT_DIR = tests/CMakeFiles/test_full_runtime_stack.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = tests/CMakeFiles/test_full_runtime_stack.dir/
  TARGET_FILE = tests/test_full_runtime_stack
  TARGET_PDB = tests/test_full_runtime_stack.pdb


