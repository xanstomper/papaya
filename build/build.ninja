build tests/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /home/jewboy420/papaya/build/tests && /usr/bin/ctest --force-new-ctest-process
  DESC = Running tests...
  pool = console
  restat = 1

build tests/test: phony tests/CMakeFiles/test.util


